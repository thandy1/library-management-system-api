# Storage backend: "database" (default) or "memory"
STORAGE_BACKEND=database

# Required when STORAGE_BACKEND=database
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://your_user:your_password@localhost:5432/your_database

# Optional: log generated SQL to development terminal (true/false)
DATABASE_ECHO_SQL=false